# 开发站使用 HTTP（http://localhost:5173）。修改后需重启 npm run dev。
# 业务后端：浏览器请求 /api，由 Vite 代理到 VITE_API_TARGET。
VITE_API_BASE_URL=/api
VITE_API_TARGET=http://10.202.210.30:32860

# 大模型对话：浏览器请求 /v1，由 Vite 代理到 VITE_LLM_API_TARGET。
# 完整路径示例：POST {VITE_LLM_API_BASE}/sessions/{VITE_LLM_SESSION_ID}/chat
VITE_LLM_API_BASE=/v1
VITE_LLM_API_TARGET=http://10.202.210.30:8772
VITE_LLM_SESSION_ID=sess_demo
# 若设为 true，则用业务会话 ID 替换上面的固定会话 ID
VITE_LLM_USE_APP_SESSION=true

# GeoServer WMS 根地址。浏览器请求 /geoserver，由 Vite 代理到该地址，避免跨域。
# 工作区示例：/geoserver/pf2122668600151068674/wms?LAYERS=pf...:r0_...
VITE_GEOSERVER_ORIGIN=http://10.202.210.30:32860/geoserver
VITE_GEOSERVER_BASE=/geoserver
# 若 GetMap 返回 401，在 .env.development.local 写账号（不带 VITE_ 前缀）
# GEOSERVER_USER=
# GEOSERVER_PASSWORD=

# 工作流产物导入：filePaths = 该源站 + outs.url 真实路径
# 例：http://10.202.210.30:32862/v1/artifacts/jiaxing-height-map.geojson
VITE_ARTIFACT_IMPORT_ORIGIN=http://10.202.210.30:32862
