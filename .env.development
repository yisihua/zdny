# 开发站启用 HTTPS（https://localhost:5173）。修改后需重启 npm run dev。
# 业务后端：浏览器请求 /api，由 Vite 代理到 VITE_API_TARGET。
VITE_API_BASE_URL=/api
VITE_API_TARGET=http://10.202.210.30:32860

# 大模型对话：直连（不经 Vite /v1 代理）。改回代理时设 VITE_LLM_API_BASE=/v1 并恢复 vite.config 里 proxy['/v1']。
# 完整路径示例：POST {VITE_LLM_API_BASE}/sessions/{VITE_LLM_SESSION_ID}/chat
VITE_LLM_API_BASE=https://10.202.210.30/v1
VITE_LLM_API_TARGET=https://10.202.210.30
VITE_LLM_SESSION_ID=sess_demo
# 若设为 true，则用业务会话 ID 替换上面的固定会话 ID
VITE_LLM_USE_APP_SESSION=false

# GeoServer：浏览器请求 /geoserver，由 Vite 代理到 VITE_GEOSERVER_TARGET
# 默认前缀 http://10.202.210.30:8090/geoserver
VITE_GEOSERVER_BASE=/geoserver
VITE_GEOSERVER_TARGET=http://10.202.210.30:8090

# 工作流产物导入：filePaths = 该源站 + outs.url 真实路径
# 例：http://10.202.210.30:32862/v1/artifacts/jiaxing-height-map.geojson
VITE_ARTIFACT_IMPORT_ORIGIN=http://10.202.210.30:32862
