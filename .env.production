# 生产构建（npm run build）写入前端包：仅 VITE_ 前缀会打进 dist。
# 改完后需重新 build；/api、/v1、/geoserver 由 Nginx 反代，见 deploy/nginx.conf。

# 业务后端（浏览器同源 /api）
VITE_API_BASE_URL=/api
VITE_API_TARGET=http://10.202.210.30:32860

# 大模型 / 工作流（浏览器同源 /v1）
VITE_LLM_API_BASE=/v1
VITE_LLM_API_TARGET=http://10.202.210.30:8772
VITE_LLM_SESSION_ID=sess_demo
VITE_LLM_USE_APP_SESSION=true

# GeoServer（浏览器同源 /geoserver）
VITE_GEOSERVER_ORIGIN=http://10.202.210.30:32860/geoserver
VITE_GEOSERVER_BASE=/geoserver

# 工作流产物导入源站
VITE_ARTIFACT_IMPORT_ORIGIN=http://10.202.210.30:32862
